# Copy to .env.local (gitignored) and fill in for your environment.
# See migration-plan/REACT_AUTH_AND_APP_SWITCH_FLOW.md §9.

VITE_API_BASE_URL=/api/v1
VITE_NEW_APP_BASE_URL=http://localhost:5173
VITE_LEGACY_APP_BASE_URL=http://localhost:7040/ihub

# Public key only — the matching private key stays on the Node backend.
VITE_LOGIN_ENCRYPTION_KEY_REFERENCE=node-login-key-2026
VITE_LOGIN_ENCRYPTION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
